# Copy this file to .env and fill in real values. .env is gitignored.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# For real-device/ngrok testing, add a wildcard entry for whichever ngrok
# TLD is actually assigned, e.g. "localhost,127.0.0.1,.ngrok-free.app,
# .ngrok-free.dev" (leading dot = any subdomain).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Dev-only, off by default: set to True when Django is reached through an
# HTTPS tunnel (e.g. ngrok) so absolute image URLs come back as https://
# instead of http://. See config/settings.py for details.
DJANGO_TRUST_X_FORWARDED_PROTO=False

# PostgreSQL / PostGIS
# Used only as a fallback to build the local dev connection string - ignored
# if DATABASE_URL is set (see below), which is what a real deploy uses.
DB_NAME=survey_app
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# A real deploy (Render's managed Postgres) provides this as a single
# connection string instead of the individual DB_* vars above - when set, it
# takes priority. Leave unset for local dev.
# DATABASE_URL=postgresql://user:password@host:port/dbname
# Render's managed Postgres requires TLS for external connections; set this
# alongside DATABASE_URL there. Leave False for local dev (no TLS listener).
DB_SSL_REQUIRE=False

# GeoDjango native library paths (Windows only; leave blank on Linux/macOS
# where Django's auto-detection normally finds GEOS/GDAL on its own).
GEOS_LIBRARY_PATH=C:\Program Files\PostgreSQL\18\bin\libgeos_c.dll
GDAL_LIBRARY_PATH=C:\Program Files\PostgreSQL\18\bin\libgdal-35.dll

# JWT (djangorestframework-simplejwt)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS - origins allowed to call this API (the Vite dev server by default).
# Not needed for ngrok phone testing with the current setup: Vite's dev-server
# proxy (vite.config.ts) forwards /api/* to Django, so the phone's browser
# only ever calls its own origin (same-origin, no CORS involved).
# For a real deploy (frontend and backend on different domains, e.g. Vercel +
# Render), this must list the actual frontend origin - e.g.
# https://survey-app.vercel.app - since that's now a genuine cross-origin call.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Media storage (Cloudflare R2, S3-compatible). Leave all unset for local dev
# - Django falls back to local disk (MEDIA_ROOT), exactly as before. A real
# deploy must set these: Render's filesystem is ephemeral (a photo saved to
# local disk is lost on the next restart/redeploy), and Django only serves
# MEDIA_URL itself when DEBUG=True, so without these, uploaded images
# wouldn't be reachable in production at all, not just fragile.
# AWS_STORAGE_BUCKET_NAME=survey-app-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# R2's S3-compatible endpoint for your account, from the Cloudflare dashboard.
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2's public R2.dev subdomain or a custom domain - host only, no scheme.
# AWS_S3_CUSTOM_DOMAIN=pub-xxxxxxxx.r2.dev
