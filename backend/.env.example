# Copy this file to .env and fill in real values. .env is gitignored.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL / PostGIS
DB_NAME=survey_app
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# GeoDjango native library paths (Windows only; leave blank on Linux/macOS
# where Django's auto-detection normally finds GEOS/GDAL on its own).
GEOS_LIBRARY_PATH=C:\Program Files\PostgreSQL\18\bin\libgeos_c.dll
GDAL_LIBRARY_PATH=C:\Program Files\PostgreSQL\18\bin\libgdal-35.dll

# JWT (djangorestframework-simplejwt)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS - origins allowed to call this API (the Vite dev server by default)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
