# Copy to .env.development / .env.production as needed. Vite env files are gitignored.
#
# Leave this BLANK for local dev and ngrok testing - src/config/env.ts falls
# back to window.location.origin, and Vite's dev/preview proxy
# (vite.config.ts) forwards /api and /media to Django from whatever origin
# the page is actually viewed from (localhost:5173 or an ngrok tunnel), so
# every request stays same-origin with no CORS involved. Only set this to an
# absolute URL for a real deploy where the frontend and backend are on
# genuinely different domains (e.g. Vercel + Render).
VITE_API_BASE_URL=
