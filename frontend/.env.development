# Left blank on purpose (matches .env.production) so src/config/env.ts falls
# back to window.location.origin - the same build then works correctly both
# from http://localhost:5173 and through an ngrok tunnel, since Vite's dev
# proxy (vite.config.ts) forwards /api and /media to Django from either
# origin. Setting this to an absolute http://localhost:8000 (the old value
# here) breaks it as soon as the page is viewed from any other origin - e.g.
# an ngrok HTTPS tunnel - because the browser then tries a direct
# cross-origin fetch to localhost:8000, which fails CORS instead of going
# through the proxy.
VITE_API_BASE_URL=
